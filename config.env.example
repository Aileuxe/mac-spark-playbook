# Site-specific values for the scripts in mac/ and spark/. Copy to config.env and fill in.
# Both machines read the same file: keep one copy per machine at ~/.config/mac-spark-playbook/config.env
# (the installers also copy it where root jobs read it).

# --- The link ------------------------------------------------------------------------------
LINK=worker-a                         # mcdma-rpcd link name
LINK_PORT=18620                       # UDP port of the setup exchange
PATH_MTU=4096                         # RDMA path MTU; must not exceed the ports' active MTU
MAILBOX_MIB="4 64"                    # request and reply mailbox halves, both ends the same

# --- Mac (decode end) ----------------------------------------------------------------------
MAC_CX5_HWADDR=aa:bb:cc:dd:ee:ff      # MAC of the CX5 port cabled to the Spark (ifconfig mcrdmaN)
MAC_CX5_GID=fe80::a8bb:ccff:fedd:eeff # its MAC-derived link-local address (EUI-64 of MAC_CX5_HWADDR)
MAC_LAN_IF=en0                        # Mac interface on the LAN the setup exchange uses
MAC_LAN_LL=fe80::1111:2222:3333:4444  # the Mac's link-local address on that LAN (ifconfig en0)
MCDMA_DIR=$HOME/src/MCDMA             # checkout of Aileuxe/MCDMA, branch playbook, built
OMLX_DIR=$HOME/src/omlx               # checkout of Aileuxe/omlx, branch feat/remote-prefill-hybrid
OMLX_BASE=$HOME/.omlx-split           # oMLX base path (settings, cache, logs) for this server
OMLX_PORT=8100
MODEL_DIR=$HOME/models                # holds Qwen3.8-Flash-Next-oQ4e-mtp/
LOCAL_MODEL=Qwen3.8-Flash-Next-oQ4e-mtp

# --- Spark (prefill end) -------------------------------------------------------------------
SPARK_HOST=spark.local                # how the Mac reaches the Spark's vLLM over TCP
SPARK_PORT=8100
SPARK_CX_IF=enp1s0f1np1               # CX7 port cabled to the Mac
SPARK_CX_HWADDR=11:22:33:44:55:66
SPARK_CX_GID=fe80::1322:33ff:fe44:5566
SPARK_RDMA_DEV=rocep1s0f1             # its RDMA device (ibv_devices)
SPARK_GID_INDEX=1                     # index of SPARK_CX_GID as a RoCE v2 GID (show_gids)
SPARK_LAN_IF=enP7s7                   # Spark interface on the same LAN as MAC_LAN_IF
SPARK_LAN_LL=fe80::5555:6666:7777:8888
SPARK_MCDMA_DIR=$HOME/MCDMA           # checkout of Aileuxe/MCDMA, branch playbook, rpc built
SPARK_MODEL=Qwen3.8-Flash-Next        # name vLLM serves the producer under
NVFP4_SNAPSHOT=                       # snapshot hash of local-inference-lab/Qwen3.8-Flash-Next-NVFP4
VLLM_IMAGE=eugr/spark-vllm-b12x:nightly-20261009
PRODUCER_CONTAINER=flashnext-producer
CACHE_DIR=$HOME/.cache/flashnext-producer   # persisted b12x and vLLM compile caches
MEMWATCH_MIN_GIB=6                    # memwatch.sh kills the producer below this much available memory
